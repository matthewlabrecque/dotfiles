// Display configuration
// Use `niri msg outputs` to get display options

output "eDP-1" { // Internal laptop display
    mode "1920x1080@60.000"
    scale 1
    transform "normal"
    position x=1920 y=0
}
output "HDMI-A-1" {
    mode "1920x1080@119.982"
    scale 1
    transform "normal"
    position x=0 y=0
}
