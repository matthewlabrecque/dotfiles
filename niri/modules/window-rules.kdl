window-rule {
  match app-id="helium-browser"
  open-maximized true
}

window-rule {
  match app-id="obsidian"
  open-maximized true
}

window-rule {
  match app-id="vesktop"
  open-maximized true
}

window-rule {
    match title="impala-nm"
    default-column-width { fixed 800; }
    default-window-height { fixed 600; }
    open-floating true
}

window-rule {
    match title="bluetui"
    default-column-width { fixed 800; }
    default-window-height { fixed 600; }
    open-floating true
}

window-rule {
    match title="wiremix"
    default-column-width { fixed 800; }
    default-window-height { fixed 600; }
    open-floating true
}
